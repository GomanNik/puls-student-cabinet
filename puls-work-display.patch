diff --git a/tests/unit/work-status.test.ts b/tests/unit/work-status.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/work-status.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest";
+import { getWorkStatus, isAwaitingReview } from "@/modules/learning/work-status";
+
+const submitted = {
+  dataState: "READY" as const,
+  assignmentStatusCode: "Выдано",
+  completionStatusCode: "Выполнение подтверждено",
+  submissionStatusCode: "Передано на проверку",
+  submittedAt: "2026-11-09T12:00:00+06:00",
+};
+
+const publishedZero = {
+  value: { kind: "NUMERIC" as const, numeric: "0", rawValueText: "0 баллов" },
+  assessedAt: "2026-11-10T10:00:00+06:00",
+};
+
+describe("единый статус учебной работы", () => {
+  it("считает выполненную и отправленную работу ожидающей проверки, если результата ещё нет", () => {
+    expect(getWorkStatus(submitted, null)).toBe("AWAITING_REVIEW");
+    expect(isAwaitingReview(submitted, null)).toBe(true);
+  });
+
+  it("считает работу проверенной, если результат опубликован, даже без reviewedAt", () => {
+    expect(getWorkStatus(submitted, publishedZero)).toBe("RESULT_PUBLISHED");
+    expect(isAwaitingReview(submitted, publishedZero)).toBe(false);
+  });
+
+  it("не считает работу ожидающей проверки, если источник результата пока не дал однозначный ответ", () => {
+    expect(getWorkStatus(submitted, undefined)).toBe("UNCERTAIN");
+    expect(isAwaitingReview(submitted, undefined)).toBe(false);
+  });
+
+  it("учитывает отметку проверки, даже если отдельный результат не опубликован", () => {
+    expect(getWorkStatus({ ...submitted, reviewStatusCode: "Проверено", reviewedAt: "2026-11-10T10:00:00+06:00" }, null)).toBe("REVIEWED");
+  });
+
+  it("возврат на доработку важнее старого опубликованного результата", () => {
+    expect(getWorkStatus({ ...submitted, reviewStatusCode: "Возвращено на доработку" }, publishedZero)).toBe("NEEDS_REVISION");
+  });
+
+  it("показывает опубликованный результат, даже если отдельной записи о выполнении нет", () => {
+    expect(getWorkStatus(undefined, publishedZero)).toBe("RESULT_PUBLISHED");
+  });
+
+  it("распознаёт ожидание проверки по статусу проверки", () => {
+    const waiting = { dataState: "READY" as const, reviewStatusCode: "На проверке" };
+    expect(getWorkStatus(waiting, null)).toBe("AWAITING_REVIEW");
+  });
+
+  it("не принимает отметку «не сдано» за отправленную работу", () => {
+    const notSubmitted = { ...submitted, submittedAt: undefined, submissionStatusCode: "Не сдано" };
+    expect(getWorkStatus(notSubmitted, null)).toBe("NOT_SUBMITTED");
+    expect(isAwaitingReview(notSubmitted, null)).toBe(false);
+  });
+
+  it("не придумывает выполнение, если по работе нет отметок", () => {
+    expect(getWorkStatus(undefined, undefined)).toBe("NO_ACTIVITY");
+  });
+
+  it("отличает недоступный источник от отсутствия отметок", () => {
+    expect(getWorkStatus({ dataState: "SOURCE_ERROR" }, undefined)).toBe("UNAVAILABLE");
+  });
+});
diff --git a/tests/integration/work-display.test.ts b/tests/integration/work-display.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/integration/work-display.test.ts
@@ -0,0 +1,71 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { randomUUID } from "node:crypto";
+import { AuthService } from "@/modules/auth/service";
+import type { AuthContext } from "@/modules/auth/context";
+import { learningService } from "@/modules/learning/composition";
+import { getWorkStatus } from "@/modules/learning/work-status";
+import { readConfig } from "@/shared/server/config";
+import { database } from "@/shared/server/db";
+import { prepareTestDatabase, testDatabase } from "../support/database";
+
+const admin = testDatabase();
+let student: AuthContext;
+
+beforeAll(async () => {
+  const fixture = await prepareTestDatabase(admin);
+  const auth = new AuthService(database(), readConfig());
+  const session = await auth.login("demo-a", fixture.passwords[0], "127.0.0.1");
+  student = await auth.requireSession(session.token, randomUUID());
+});
+
+afterAll(async () => {
+  await admin.$disconnect();
+  await database().$disconnect();
+});
+
+async function mathematics() {
+  const service = await learningService(student, admin);
+  const period = service.context.record.periods.find(item => item.periodId === "fall-2026")!;
+  const periodId = service.context.periodId(period);
+  for await (const binding of service.bindings(periodId)) {
+    if (binding.title === "Математический анализ") return { service, binding };
+  }
+  throw new Error("Не найдена дисциплина «Математический анализ».");
+}
+
+describe("отображение учебных работ", () => {
+  it("не считает опубликованный нулевой результат работой, ожидающей проверки", async () => {
+    const { service, binding } = await mathematics();
+    const list = await service.listWorks(binding, 100, undefined, { filter: "ALL", sort: "DUE", query: "" });
+    const lab3 = list.data.items.find(item => item.title.startsWith("Лабораторная работа № 3:"))!;
+
+    expect(lab3.progress?.submittedAt).toBeTruthy();
+    expect(lab3.progress?.reviewedAt).toBeUndefined();
+    expect(lab3.publishedResult?.value.rawValueText).toBe("0 баллов");
+    expect(getWorkStatus(lab3.progress, lab3.publishedResult)).toBe("RESULT_PUBLISHED");
+    const detail = await service.workDetail(binding, lab3.workId);
+    expect(detail.data.work.publishedResult?.value.rawValueText).toBe("0 баллов");
+
+    const review = await service.listWorks(binding, 100, undefined, { filter: "REVIEW", sort: "DUE", query: "" });
+    expect(review.data.items.some(item => item.workId === lab3.workId)).toBe(false);
+    expect(review.data.items).toHaveLength(0);
+  });
+
+  it("показывает точное количество работ по всей дисциплине, а не по первой странице", async () => {
+    const { service, binding } = await mathematics();
+    const detail = await service.offeringDetail(binding);
+
+    expect(detail.data.works).toHaveLength(20);
+    expect(detail.data.worksState.nextCursor).toBeTruthy();
+    expect(detail.data.workCounts).toEqual({ total: 26, reviewed: 2, awaitingReview: 0 });
+  });
+
+  it("возвращает опубликованный результат в списке результатов без отдельной хронологии", async () => {
+    const { service, binding } = await mathematics();
+    const results = await service.listWorks(binding, 20, undefined, { filter: "RESULT", sort: "DUE", query: "" });
+
+    expect(results.data.items).toHaveLength(1);
+    expect(results.data.items[0].title).toMatch(/^Лабораторная работа № 3:/u);
+    expect(results.data.items[0].publishedResult?.value.rawValueText).toBe("0 баллов");
+  });
+});

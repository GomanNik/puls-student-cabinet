+        const stagePublishedResult = stageResult ? { value: stageResult.value, ...(stageResult.assessedAt ? { assessedAt: stageResult.assessedAt } : {}) } : detail.resultsState.isComplete === true ? null : undefined;
+        return <section className="surface stage-card" key={stage.stageId} id={stage.stageId} tabIndex={-1}>
+          <div className="learning-work-state-head"><h3>{stage.title}</h3><WorkStatusBadge progress={stage.progress ?? { dataState: "UNKNOWN" }} publishedResult={stagePublishedResult} /></div>
+          {stage.description && <p>{stage.description}</p>}
+          {stage.due && <p className="muted">Срок сдачи: {academicDate(stage.due)}</p>}
+        </section>;
+      }) : <p className="notice">{detail.stagesState.isComplete === true ? "Этапы пока не добавлены." : "Не удалось загрузить этапы."}</p>}</section>
+      <section className="learning-work-wide"><h2>Связанные материалы</h2>{detail.relatedMaterials.length ? <MaterialCards items={detail.relatedMaterials} /> : <p className="notice">{detail.materialsState.isComplete === true ? "Материалы пока не добавлены." : "Не удалось загрузить материалы."}</p>}</section>

# Только имена: значения задаются оператором. Не коммитить заполненный файл.
APP_ORIGIN=
# Для Docker Compose: домен без схемы и два разных случайных пароля БД.
PULS_HOST=
POSTGRES_PASSWORD=
PULS_WEB_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
AUTH_RATE_LIMIT_HMAC_KEY=
TRUSTED_PROXY_KEY=
SESSION_COOKIE_NAME=
# Только серверный режим вымышленного учебного источника; по умолчанию normal.
# normal | missing-assignment | conflicting-assignment | schedule-error | changes-error |
# partial-attendance | invalid-scope | revision-change | works-error | partial-works | materials-error
# Также <dataset>-partial/no-data/error/timeout, materials-invalid-link,
# deadline-before / deadline-moved; точный каталог и даты описаны в README.
PULS_FIXTURE_SCENARIO=normal
# Серверные административные фикстуры: normal | unavailable | timeout | rejected |
# timeout-after-accept | duplicate-reply | stale-status.
PULS_ADMIN_FIXTURE_SCENARIO=normal
# normal | announcements-<error/timeout/partial/no-data> | calendar-<error/timeout/partial/no-data>.
PULS_COMMUNITY_FIXTURE_SCENARIO=normal
# Без ключей используется явно обозначенный демонстрационный помощник.
# Для внешнего провайдера: GIGACHAT; ключ передаётся только серверу.
PULS_AI_PROVIDER=DEMO_MOCK
# Только серверная фикстура ИИ: normal | partial | no-data | error | timeout.
PULS_AI_FIXTURE_SCENARIO=normal
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Для TLS GigaChat выполните node scripts/prepare-gigachat-ca.mjs и задайте
# NODE_EXTRA_CA_CERTS до запуска Node.js (переменная внутри .env.local слишком поздняя).
# Опциональная платная проверка реального сервиса: задавайте только на время запуска.
# GIGACHAT_LIVE_TEST=1
# Временные секреты только при явном seed; удалить из окружения после запуска.
PULS_SEED_PASSWORD_A=
PULS_SEED_PASSWORD_B=
# Явный opt-in собственных демо-операций; обычный seed оставляет их нетронутыми.
PULS_SEED_DEMO_OPERATIONS=0
# Только при первоначальном создании demo-b: отсутствующие поля профиля.
PULS_SEED_PARTIAL_PROFILE_B=0

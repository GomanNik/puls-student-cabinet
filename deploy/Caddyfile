{
  admin off
}
{$PULS_HOST} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"
  @internal path /api/health/ready
  respond @internal 404
  reverse_proxy web:3000 {
    header_up -X-Puls-*
    header_up -X-Health-Token
    header_up -Forwarded
    header_up X-Puls-Proxy-Key {$TRUSTED_PROXY_KEY}
    header_up X-Puls-Client-IP {remote_host}
    header_up X-Forwarded-Proto https
  }
}

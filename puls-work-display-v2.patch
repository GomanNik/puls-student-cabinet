index a64269a..c404eea 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1551,3 +1551,54 @@ body { min-width:0; }
   .agenda-lesson-tags i { font-size:11px; }
   .catalog-row-copy small { font-size:12px; }
 }
+
+/* Единое представление состояния учебных работ */
+.work-status { display:inline-flex; align-items:center; width:max-content; max-width:100%; white-space:normal; }
+.work-status--result_published,.work-status--reviewed { color:#24613D; background:#EAF5EE; }
+.work-status--awaiting_review { color:#875711; background:#FFF3DF; }
+.work-status--needs_revision,.work-status--not_submitted,.work-status--not_completed { color:#963A45; background:#FBEDEF; }
+.work-status--in_progress,.work-status--completed { color:#76551B; background:#F7F1E6; }
+.work-status--not_started,.work-status--uncertain,.work-status--unavailable,.work-status--not_applicable { color:#66545C; background:#F1ECEF; }
+.work-card-top { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
+.work-card-top>.status-tag { justify-self:start; }
+.learning-r9-main .work-card h3 a { color:inherit; text-decoration:none; }
+.learning-r9-main .work-card h3 a:hover { color:#A80D42; text-decoration:underline; }
+.learning-r9-main .work-card-facts span:last-child { color:inherit; font-weight:500; }
+.learning-r9-main .work-card-open { justify-self:start; margin-top:3px; }
+.discipline-stat-copy { display:grid; gap:4px; min-width:0; }
+.discipline-stat-copy>strong { color:#B30842; font:700 clamp(25px,2vw,32px)/1 var(--puls-serif); }
+.discipline-stat-copy>span { color:#321824; font:700 16px/1.25 var(--puls-sans); }
+.discipline-stat-copy>small { color:#705B64; font:500 12px/1.35 var(--puls-sans); }
+.discipline-stat-attestation .discipline-stat-copy>strong { font:700 16px/1.3 var(--puls-sans); }
+.discipline-attention-item>.work-status { flex:none; }
+.discipline-result-card { min-height:0; }
+.discipline-result-card .work-card-top { margin-bottom:2px; }
+.discipline-result-card h3 a { color:inherit; text-decoration:none; }
+.discipline-result-card h3 a:hover { color:#A80D42; text-decoration:underline; }
+.discipline-result-value { display:flex; align-items:baseline; justify-content:space-between; gap:14px; padding-top:8px; border-top:1px solid #F0E4E8; color:#705B64; font-size:13px; }
+.discipline-result-value strong { color:#A70C3D; font-size:18px; }
+.learning-work-state { align-self:start; }
+.learning-work-state-head { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; }
+.learning-work-state-head h2,.learning-work-state-head h3 { margin:0; }
+.learning-work-state>p { margin:10px 0 0; }
+.learning-work-result-list { display:grid; gap:8px; margin-top:14px; padding-top:12px; border-top:1px solid var(--border); }
+.learning-work-result-list>span { color:var(--muted); font-size:13px; }
+.learning-work-result-row { display:flex; align-items:baseline; justify-content:space-between; gap:14px; }
+.learning-work-result-row span { color:var(--secondary); font-size:13px; }
+.learning-work-result-row strong,.learning-work-result-list>strong { color:var(--primary); font-size:19px; }
+.learning-work-stages { display:grid; gap:10px; margin-top:22px; }
+.learning-work-stages>h3 { margin:0; font-size:17px; }
+.learning-work-stage { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:14px 0; border-top:1px solid var(--border); scroll-margin-top:24px; }
+.learning-work-stage-copy { display:grid; gap:5px; min-width:0; }
+.learning-work-stage-copy>strong { color:var(--text); }
+.learning-work-stage-copy>p { margin:0; color:var(--secondary); font-size:14px; }
+.learning-work-stage-meta { display:grid; justify-items:end; gap:8px; flex:none; }
+.learning-work-stage-meta>span:not(.status-tag) { color:var(--muted); font-size:12px; }
+@media(max-width:600px) {
+  .discipline-stat { gap:13px; padding:13px; }
+  .discipline-stat-copy>span { font-size:14px; }
+  .discipline-stat-copy>small { font-size:11px; }
+  .discipline-attention-item>.work-status { margin-left:62px; }
+  .learning-work-stage { display:grid; gap:10px; }
+  .learning-work-stage-meta { display:flex; flex-wrap:wrap; align-items:center; justify-items:start; }
+}

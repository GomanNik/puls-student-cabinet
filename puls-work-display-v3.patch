 }
+
+
+/* Чёткая вертикальная структура показателей дисциплины. */
+.discipline-stat-copy { display:flex !important; flex:1; flex-direction:column; align-items:flex-start; justify-content:center; gap:4px; min-width:0; line-height:1.25; }
+.discipline-stat-copy > strong,.discipline-stat-copy > span,.discipline-stat-copy > small { display:block; max-width:100%; white-space:normal; }
+.discipline-stat-copy > .discipline-stat-value { color:#B30842; font:700 clamp(25px,2vw,32px)/1.05 var(--puls-serif); }
+.discipline-stat-copy > .discipline-stat-title { color:#321824; font:700 16px/1.25 Arial,"Helvetica Neue",system-ui,sans-serif; }
+.discipline-stat-copy > .discipline-stat-attestation-value { color:#321824; font:700 16px/1.3 Arial,"Helvetica Neue",system-ui,sans-serif; }
+.discipline-stat-copy > small { color:#705B64; font:500 12px/1.35 Arial,"Helvetica Neue",system-ui,sans-serif; }
+
+/* Журнал посещаемости: одна строка на одно занятие. */
+.discipline-attendance-table { min-width:0; }
+.discipline-attendance-table-head,.discipline-attendance-table-row { display:grid; grid-template-columns:minmax(150px,190px) minmax(220px,1fr) minmax(150px,190px); align-items:center; gap:16px; }
+.discipline-attendance-summary-row { display:grid; grid-template-columns:1fr; padding:9px 14px; border-bottom:1px solid #E8D8DE; color:var(--muted); font-size:12px; }
+.discipline-attendance-summary-row [role="cell"] { grid-column:1 / -1; }
+.discipline-attendance-table-head { padding:11px 14px; border-bottom:1px solid #E8D8DE; color:#705B64; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.035em; }
+.discipline-attendance-table-body { display:grid; gap:0; }
+.discipline-attendance-table-row { min-height:58px; padding:10px 14px; border-bottom:1px solid #F0E4E8; color:#38232D; font-size:14px; }
+.discipline-attendance-table-row:last-child { border-bottom:0; }
+.discipline-attendance-lesson { display:grid; gap:3px; min-width:0; }
+.discipline-attendance-lesson strong { overflow-wrap:anywhere; font-weight:600; }
+.discipline-attendance-lesson small { color:var(--muted); font-size:12px; }
+.attendance-status { display:inline-flex; align-items:center; justify-content:center; min-height:28px; width:max-content; max-width:100%; padding:5px 10px; border-radius:7px; font-size:12px; font-weight:700; line-height:1.2; }
+.attendance-status.is-present { color:#176B43; background:#E8F5ED; }
+.attendance-status.is-absent { color:#9C2637; background:#FBEAEC; }
+.attendance-status.is-other { color:#76551B; background:#F7F1E6; }
+.attendance-status.is-unmarked { color:#66545C; background:#F1ECEF; }
+.attendance-status.is-unavailable { color:#8A4C16; background:#FFF1E2; }
+
+/* Нумерованная постраничная навигация работ. */
+.work-pagination { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:10px; margin-top:24px; }
+.work-pagination-current { color:var(--muted); font-size:13px; }
+.catalog-row-copy strong a { color:inherit; text-decoration:none; }
+.catalog-row-lesson { color:#A70C3D !important; font-weight:600; }
+.catalog-row-lesson a { color:inherit; text-decoration:underline; text-underline-offset:2px; }
+@media(max-width:700px) {
+  .discipline-attendance-table { overflow-x:auto; }
+  .discipline-attendance-table-head,.discipline-attendance-table-row { min-width:640px; }
+  .work-pagination { justify-content:flex-start; }
+}

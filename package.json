{
  "name": "puls-student-cabinet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack && node scripts/license-notices.mjs",
    "start": "node scripts/start.mjs",
    "https": "node scripts/local-https.mjs",
    "worker": "tsx --conditions=react-server scripts/administration-worker.ts",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "lint": "eslint src tests scripts prisma/seed.ts *.ts *.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "check:matrix": "node scripts/generate-test-matrix.mjs --check",
    "test:e2e": "pnpm build && playwright test",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 -Stop"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.2.3",
    "argon2": "0.44.0",
    "exceljs": "4.4.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "0.577.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "undici": "6.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "selfsigned": "3.0.1",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32",
      "sharp": "0.35.5",
      "minimatch": "11.0.8"
    }
  }
}
